// AMX Modero MT-702 (i.MX6 Quad "Modero-X") — FIRST DRAFT board DT.
// Strategy: boot once with the stock imx6q-sabresd.dtb to get a serial login, THEN
// drop this in and iterate display -> touch -> audio over the serial console.
// Confirmed values come from the live stock device; items marked TODO/VERIFY need
// checking against boot logs (and, for exact panel porches, the panel datasheet).
//
// Build: copy into linux/arch/arm/boot/dts/nxp/imx/, add to the Makefile, `make dtbs`.

/dts-v1/;
#include "imx6q.dtsi"
#include "imx6qdl-sabresd.dtsi"   // reuse SoC plumbing (uart1, fec, usdhc, iomuxc, i2c pinmux)

/ {
	model = "AMX Modero MT-702 (i.MX6 Quad Modero-X)";
	compatible = "amx,modero-mx6", "fsl,imx6q-sabresd", "fsl,imx6q";

	memory@10000000 {
		device_type = "memory";
		reg = <0x10000000 0x70000000>;	// 1.75 GB (confirmed MemTotal ~1762336 kB)
	};

	/* LVDS panel: native 800x1280@60, RGB24 (24-bit), single LVDS channel on DI0.
	 * TODO/VERIFY exact timings (porches/clock) — these are a reasonable 800x1280@60
	 * starting point; refine from the panel datasheet if the image is unstable. */
	panel_lvds: panel-lvds {
		compatible = "panel-lvds";
		backlight = <&backlight_modero>;
		width-mm = <94>;	// ~7" 800x1280 — VERIFY
		height-mm = <151>;
		data-mapping = "vesa-24";
		panel-timing {
			clock-frequency = <68000000>;	// ~68 MHz for 800x1280@60 — VERIFY
			hactive = <800>;
			vactive = <1280>;
			hfront-porch = <20>;
			hsync-len = <24>;
			hback-porch = <20>;
			vfront-porch = <10>;
			vsync-len = <4>;
			vback-porch = <10>;
			hsync-active = <0>;
			vsync-active = <0>;
			de-active = <1>;
			pixelclk-active = <1>;
		};
		port {
			panel_in_modero: endpoint {
				remote-endpoint = <&lvds0_out>;
			};
		};
	};

	backlight_modero: backlight {
		compatible = "pwm-backlight";
		pwms = <&pwm1 0 5000000>;	// TODO/VERIFY which PWM drives the backlight
		brightness-levels = <0 8 16 32 64 128 192 255>;
		default-brightness-level = <6>;
	};
};

/* Display: single LVDS channel 0, 24-bit "spwg", on IPU DI0 (stock: ldb=sin0, DI0). */
&ldb {
	status = "okay";
	/delete-node/ lvds-channel@1;	// SABRE's 18-bit ch1 panel — not ours
	lvds-channel@0 {
		fsl,data-mapping = "spwg";
		fsl,data-width = <24>;
		status = "okay";
		port@4 {
			reg = <4>;
			lvds0_out: endpoint {
				remote-endpoint = <&panel_in_modero>;
			};
		};
	};
};

/* ---- I²C layout (authoritative, read from the live device) ----
 * i2c1: PFUZE100 @0x08 (inherited from sabresd dtsi — keep), EEPROM 24c02 @0x50
 * i2c2: USB3503 @0x08, SGTL5000 @0x0a, pots AD5245 @0x2c / AD5243 @0x2f
 * i2c3: Atmel maXTouch mXT336T @0x4a
 * NOTE: sabresd.dtsi declares a WM8962 codec on i2c1 and other devices that we DON'T
 * have — those nodes may need /delete-node/ or status="disabled" once we see which
 * probes fail. Handle during serial bring-up. */

&i2c1 {
	eeprom@50 {
		compatible = "atmel,24c02";
		reg = <0x50>;
		pagesize = <16>;
	};
};

&i2c2 {
	status = "okay";
	sgtl5000: codec@0a {
		compatible = "fsl,sgtl5000";
		reg = <0x0a>;
		clocks = <&clks IMX6QDL_CLK_CKO>;	// VERIFY codec MCLK source
		VDDA-supply = <&reg_module_3v3>;	// VERIFY regulator names on this board
		VDDIO-supply = <&reg_module_3v3>;
	};
	usb3503@08 {
		compatible = "smsc,usb3503";
		reg = <0x08>;
		/* TODO: reset/connect/intn GPIOs from board file (unknown) */
	};
	/* AD5245 @0x2c, AD5243 @0x2f — likely VCOM/gain; add if needed */
};

&i2c3 {
	status = "okay";
	touchscreen@4a {
		compatible = "atmel,maxtouch";
		reg = <0x4a>;
		/* TODO/VERIFY: interrupt GPIO + reset GPIO (unknown — from board file or scope) */
		/* interrupt-parent = <&gpioX>; interrupts = <Y IRQ_TYPE_EDGE_FALLING>; */
	};
};

/* UART1 = console (ttymxc0 @ 115200) — provided by sabresd dtsi. */
/* FEC ethernet — provided by sabresd dtsi; MAC comes from U-Boot (ethaddr). */
